# Copy to backend.env (never committed). The real environment overrides these.
# The Davis user the mirrors are written for; its email in Davis is the address invitations are shown for. The same
# user and password log into the accounts page.
DAVIS_URL=http://127.0.0.1:9000/dav/
DAVIS_USER=abd
DAVIS_PASSWORD=change-me
# SQLite database (accounts, their sign-ins): keep it out of git, back it up in prod.
DB_PATH=data/backend.db
# Obsidian vault name in the obsidian:// link written on each event (empty = Obsidian's last vault).
VAULT=
# Where times given in UTC are written (IANA name).
TIMEZONE=Europe/Paris
# How often the mirror collections are read (my answers, relayed), and the accounts.
DAVIS_INTERVAL=30s
SOURCE_INTERVAL=5m

# The accounts page: where it listens (empty = no page), and its public address. BASE_URL/oauth/callback is the
# redirect URI given to Google and Microsoft (docs/comptes.md); http://localhost works for both while testing.
LISTEN=127.0.0.1:8080
BASE_URL=http://localhost:8080
# Google Cloud project's OAuth client (Web application). Empty = no Google accounts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra app registration (personal and organization accounts). Empty = no Microsoft accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# The Claude connector (docs/SPEC.md §10), at BASE_URL/mcp. VAULT_DIR: the vault livesync-bridge mirrors (its notes/
# folder), with the connector's history/ and trash/ beside it; empty = calendar and tasks only. The extension's
# settings (they don't sync): its tasks folder, events folder and event note day format.
VAULT_DIR=
TASKS_FOLDER=Tasks
EVENTS_FOLDER=Calendar
EVENT_DATE_FORMAT=DD-MM-YYYY
