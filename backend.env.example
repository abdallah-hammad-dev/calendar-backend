# Copy to backend.env (never committed). The real environment overrides these.
# The Davis user the mirrors are written for; its email in Davis is the address invitations are shown for.
DAVIS_URL=http://127.0.0.1:9000/dav/
DAVIS_USER=abd
DAVIS_PASSWORD=change-me
# SQLite database (accounts, tokens later): keep it out of git, back it up in prod.
DB_PATH=data/backend.db
# Obsidian vault name in the obsidian:// link written on each event (empty = Obsidian's last vault).
VAULT=
# Where times given in UTC are written (IANA name).
TIMEZONE=Europe/Paris
# How often the mirror collections are read (my answers), and the accounts.
DAVIS_INTERVAL=30s
SOURCE_INTERVAL=5m
