# Copier en davis.env et remplir les deux secrets (APP_SECRET : `openssl rand -hex 16`).
APP_ENV=prod
APP_SECRET=change-me
APP_TIMEZONE=Europe/Paris
DATABASE_DRIVER=sqlite
DATABASE_URL=sqlite:////data/davis-database.db
CALDAV_ENABLED=true
CARDDAV_ENABLED=false
WEBDAV_ENABLED=false
PUBLIC_CALENDARS_ENABLED=false
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
ADMIN_AUTH_BYPASS=false
AUTH_METHOD=Basic
AUTH_REALM=SabreDAV
INVITE_FROM_ADDRESS=
MAILER_DSN=null://null
SYMFONY_TRUSTED_PROXIES=REMOTE_ADDR
# Pas de journal : sur une erreur (404, 412, 403, normaux en synchro), Davis y écrit la requête entière, en-têtes
# compris, donc le mot de passe envoyé en Basic. Pour déboguer, mettre un chemin le temps du test.
LOG_FILE_PATH=/dev/null
